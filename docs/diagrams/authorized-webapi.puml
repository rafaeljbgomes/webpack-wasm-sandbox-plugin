@startuml
!theme plain
autonumber
title Permission-Selected Host Capability
hide footbox

skinparam defaultFontSize 15

box "Host Environment" #f1f1f1
    participant "Sandbox\nManager" as Manager
    participant "Generated Proxy\n(explicit permissions)" as Config
    participant "Forward\nMembrane" as HostVmMembrane
    participant "Allowed Host\nCapabilities" as HostCapabilities
end box

box "Sandbox" #e9e9e9
    participant "Isolated\nLibrary" as Library
end box

== Capability exposure ==

Config -> Manager: Initializes library with\ncompiler-selected permissions
activate Manager
activate Config
note over Config, Manager: Direct callers may omit permissions\nto use the legacy default-policy fallback
deactivate Config

Manager -> HostVmMembrane: Requests capability mediation
activate HostVmMembrane
HostVmMembrane -> HostCapabilities: Gets allowed\nobject
activate HostCapabilities
HostCapabilities --> HostVmMembrane: Allowed object
deactivate HostCapabilities

HostVmMembrane --> HostVmMembrane: Wraps allowed object

HostVmMembrane --> Manager: Mediated capability
deactivate HostVmMembrane

Manager -> Library: Exposes allowed reference in isolated context
activate Library
Library --> Manager: Capability available for controlled use
deactivate Library
deactivate Manager

== Library use ==

Library -> HostVmMembrane: Invokes mediated capability
activate Library
activate HostVmMembrane
HostVmMembrane -> HostCapabilities: Executes allowed\noperation
activate HostCapabilities
HostCapabilities --> HostVmMembrane: Result
deactivate HostCapabilities
alt Fresh plain-data result
    HostVmMembrane --> Library: Copied value
else Other host object
    HostVmMembrane --> Library: Mediated result
end
deactivate HostVmMembrane
deactivate Library

@enduml
